__pycache__/
*.pyc
.venv/
config.toml
config.local.toml
# A backup of an ignored file is ignored. Without this a
# timestamped config backup shows up as untracked and reads as
# something to deal with, when the file it copies is already
# deliberately out of the repo.
config.toml.bak-*
config.*.bak-*
.superpowers/
# doctor's default state file, written to the current directory when
# --state is not given; it holds a real store's findings.
.spoke-doctor.json
*.egg-info/
# packaging output
build/
dist/
